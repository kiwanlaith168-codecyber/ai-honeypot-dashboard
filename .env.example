# Copy this file to ".env" and fill in your own values.
# ".env" is git-ignored. NEVER commit real keys or passwords.

# Optional: enables LLM-written session narratives (fallback text is used if empty)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Dashboard login (if ADMIN_PASSWORD is empty, a random one is generated each run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
FLASK_SECRET_KEY=

# Dashboard bind address (127.0.0.1 = this machine only)
FLASK_HOST=127.0.0.1
